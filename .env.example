# Copy to .env. Every value is optional: with nothing set, Relais runs in demo mode on SQLite.

# With a key, the agent uses Claude. Without one, a labelled keyword script.
ANTHROPIC_API_KEY=
# auto | real | demo. "real" refuses to start without a key.
AI_MODE=auto
AI_AGENT_MODEL=claude-opus-5-5
AI_CLASSIFY_MODEL=claude-opus-5-5
AI_EFFORT=medium

# sqlite:///./relais.db locally; PostgreSQL in Docker.
DATABASE_URL=sqlite:///./relais.db

# Protect the webhook and the dashboard outside a local demo.
INBOUND_API_KEY=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

ERP_BASE_URL=http://127.0.0.1:8200/mock-erp
ERP_TOKEN=dev-erp-token
